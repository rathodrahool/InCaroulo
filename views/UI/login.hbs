<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>{{title}} - InCaroulo </title>
        <script src='https://cdn.tailwindcss.com'></script>
    </head>
    <body class='bg-gray-100'>
        <div class='flex items-center justify-center min-h-screen bg-gray-100'>
            <div class='bg-white p-8 rounded-lg shadow-lg w-full max-w-md'>
                <h2 class='text-2xl font-semibold text-gray-700 text-center mb-6'>
                    Log In to Your Account
                </h2>

                <!-- Login Form -->
                <form id='loginForm' action='login' method='POST'>
                    <!-- Email Address -->
                    <div class='mb-4'>
                        <label class='block text-gray-600 font-semibold mb-2' for='email'>Email Address</label>
                        <input
                            type='email'
                            id='email'
                            name='email'
                            class='w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400'
                            placeholder='Enter your email'
                            required
                        />
                    </div>

                    <!-- Password -->
                    <div class='mb-6'>
                        <label class='block text-gray-600 font-semibold mb-2' for='password'>Password</label>
                        <input
                            type='password'
                            id='password'
                            name='password'
                            class='w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400'
                            placeholder='Enter your password'
                            required
                        />
                    </div>

                    <!-- Login Button -->
                    <div>
                        <button
                            type='submit'
                            class='w-full bg-green-500 text-white px-6 py-2 rounded-lg shadow-lg hover:bg -green-600 transition duration-300'
                        >
                            Log In
                        </button>
                    </div>
                </form>

                <!-- Forgot Password & Sign Up Links -->
                <p class='text-center text-gray-600 mt-6'>
                    <a href='forget' class='text-blue-600 hover:underline'>Forgot Password?</a>
                </p>
                <p class='text-center text-gray-600 mt-3'>
                    Don't have an account?
                    <a href='signup' class='text-blue-600 hover:underline'>Sign Up</a>
                </p>

                <!-- Error Toast Notification -->
                <div
                    id='error-toast'
                    class='fixed right-4 bottom-4 bg-red-100 text-red-700 p-4 rounded-lg shadow-lg flex items-center space-x-4'
                    style='display: none;'
                >
                    <div>
                        <ul></ul>
                        <!-- This will be populated with error messages -->
                    </div>
                    <button id='close-toast' class='ml-4 text-red-600 hover:text-red-800 focus:outline-none'>
                        &times;
                    </button>
                </div>
            </div>
        </div>
        <script src='/js/login.js'></script>
    </body>
</html>