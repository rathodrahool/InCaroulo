<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>Dashboard</title>
        <script src='https://cdn.tailwindcss.com'></script>
        <link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css' />
        <link href='https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap' rel='stylesheet' />
    </head>
    <body class='bg-gradient-to-br from-blue-50 to-green-50 font-roboto'>

        <div class='min-h-screen flex items-center justify-center'>
            <div class='bg-white p-8 rounded-lg shadow-lg max-w-2xl w-full'>
                <h1 class='text-4xl font-bold text-gray-800 text-center'>
                    Free
                    <span class='text-green-600 bg-green-100 px-2 py-1 rounded'>Dashboard</span>
                </h1>
                <p class='text-2xl text-gray-800 text-center mt-2'>Manage your role and content</p>

                <form action='dashboard' method='POST' class='mt-6'>
                    <!-- Role Selection -->
                    <div class='mb-6 text-left'>
                        <label for='label' class='block text-sm font-medium text-blue-600'>Role</label>
                        <div class='relative'>
                            <select
                                id='label'
                                name='label'
                                class='w-full bg-gray-100 border border-blue-300 rounded-lg py-3 px-4 appearance-none focus:outline-none focus:ring-2 focus:ring-blue-500'
                            >
                                <option value='ceo'>CEO</option>
                                <option value='hiring-manager'>Hiring Manager</option>
                            </select>
                            <div
                                class='pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700'
                            >
                                <i class='fas fa-chevron-down'></i>
                            </div>
                        </div>
                    </div>

                    <!-- Name Input -->
                    <div class='mb-6 text-left'>
                        <label for='name' class='block text-sm font-medium text-blue-600'>Name</label>
                        <input
                            type='text'
                            id='name'
                            name='name'
                            placeholder='Enter name'
                            class='w-full bg-gray-100 border border-blue-300 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-blue-500'
                        />
                    </div>

                    <!-- Content Textarea -->
                    <div class='mb-6 text-left'>
                        <label for='content' class='block text-sm font-medium text-blue-600'>Content</label>
                        <textarea
                            id='content'
                            name='content'
                            rows='10'
                            placeholder='Enter website content'
                            class='w-full bg-gray-100 border border-blue-300 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-blue-500'
                        ></textarea>
                    </div>

                    <!-- Email Input -->
                    <div class='mb-6 text-left'>
                        <label for='email' class='block text-sm font-medium text-blue-600'>Email</label>
                        <input
                            type='email'
                            id='email'
                            name='email'
                            placeholder='Enter email'
                            class='w-full bg-gray-100 border border-blue-300 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-blue-500'
                        />
                    </div>

                    <!-- Submit Button -->
                    <div class='flex justify-center'>
                        <button
                            type='submit'
                            class='w-full bg-blue-500 text-white p-3 rounded-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'
                        >
                            Submit
                            <i class='fas fa-arrow-right ml-2'></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </body>
</html>